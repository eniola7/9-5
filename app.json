{
  "expo": {
    "name": "LOLO",
    "slug": "lolo-fintech-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "lolo",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7FAF6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "name": "LOLO - Financial Reflection",
      "shortName": "LOLO",
      "themeColor": "#1F8F5F",
      "backgroundColor": "#F7FAF6",
      "description": "Financial clarity for people building real lives."
    },
    "plugins": [
      "expo-font"
    ]
  }
}
